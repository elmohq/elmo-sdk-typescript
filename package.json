{
  "name": "@elmohq/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Elmo API",
  "keywords": [
    "api",
    "client",
    "elmohq",
    "sdk",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/elmohq/elmo-sdk-typescript/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elmohq/elmo-sdk-typescript.git"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./calls": {
      "types": "./dist/calls/index.d.mts",
      "default": "./dist/calls/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "default": "./dist/types/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "prepack": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:package": "npm run build && vitest run --config vitest.package.config.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:package"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.4",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.74.0",
    "publint": "^0.3.21",
    "tsdown": "^0.22.14",
    "typescript": "^5.5.0 || ^6.0.0 || ^7.0.0",
    "vitest": "^4.0.0 || ^5.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
