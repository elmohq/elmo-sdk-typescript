{
  "compilerOptions": {
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@elmohq/sdk": ["./src/index.ts"],
      "@elmohq/sdk/calls": ["./src/calls/index.ts"],
      "@elmohq/sdk/types": ["./src/types/index.ts"]
    },
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src", "tests"]
}
